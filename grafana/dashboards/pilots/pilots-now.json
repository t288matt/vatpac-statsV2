    {
      "id": 4,
      "type": "timeseries",
      "title": "Pilots online over the last 24 hours",
      "description": "Pilots online in each time bucket over the last 24 hours, UTC. Whole network on the left axis; the region on the right axis because its numbers are much smaller, so read the two scales separately. The table shows the latest, highest, lowest and average value. Same query as before the redesign (no v1 card).",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "vatpac"
      },
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 12,
        "h": 10
      },
      "interval": "1m",
      "timeFrom": "24h",
      "hideTimeOverride": true,
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "vatpac"
          },
          "refId": "A",
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroupAlias(observed_at, $__interval),\n       avg(pilots_in_region) AS \"In region\",\n       avg(pilots_global) AS \"Network-wide\"\nFROM network_history\nWHERE $__timeFilter(observed_at)\nGROUP BY 1\nORDER BY 1"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull",
            "max",
            "min",
            "mean"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "#3AA0DD"
          },
          "decimals": 0,
          "unit": "none",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 28,
            "gradientMode": "opacity",
            "showPoints": "never",
            "spanNulls": true,
            "axisPlacement": "left",
            "axisSoftMin": 0,
            "axisBorderShow": false
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Network-wide"
            },
            "properties": [
              {
                "id": "displayName",
