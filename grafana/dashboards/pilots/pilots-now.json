    {
      "id": 8,
      "type": "stat",
      "title": "Region share of the network",
      "description": "Pilots in the region as a percentage of pilots on the whole network, latest network snapshot (no v1 card). There is no change arrow: a percentage change of a percentage would be easy to misread.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "vatpac"
      },
      "timeFrom": "1h",
      "hideTimeOverride": true,
      "gridPos": {
        "x": 16,
        "y": 5,
        "w": 8,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "vatpac"
          },
          "format": "time_series",
          "rawSql": "SELECT observed_at AS time, 100.0 * pilots_in_region / NULLIF(pilots_global, 0) AS \"Region share\"\nFROM network_history\nWHERE $__timeFilter(observed_at)\nORDER BY 1",
          "refId": "A",
          "editorMode": "code",
          "rawQuery": true
        }
      ],
