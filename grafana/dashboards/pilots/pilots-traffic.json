    {
      "id": 12,
      "type": "table",
      "title": "Highest groundspeeds (last 7 days)",
      "description": "Highest peak groundspeeds per callsign over the last 7 days.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "vatpac"
      },
      "gridPos": {
        "x": 0,
        "y": 51,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "vatpac"
          },
          "refId": "A",
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT callsign, pilot, aircraft_icao AS aircraft, departure, arrival,\n       max_gs_kt AS \"Peak groundspeed (kt)\", max_alt_ft AS \"Highest altitude (ft)\", end_time AS \"Flight ended\"\nFROM (\n  SELECT f.callsign, f.name AS pilot, f.aircraft_icao, f.departure, f.arrival, f.max_gs_kt, f.max_alt_ft, f.end_time,\n         row_number() OVER (PARTITION BY f.callsign ORDER BY f.max_gs_kt DESC, f.end_time DESC) AS rn\n  FROM flight_ext f\n  WHERE f.end_time BETWEEN $__timeFrom() AND $__timeTo()\n    AND f.max_gs_kt > 100 AND f.max_gs_kt <= 750\n    AND f.max_alt_ft > 1000\n    AND f.arrival IS NOT NULL AND f.arrival <> ''\n    AND f.aircraft_icao IS NOT NULL\n    AND NOT f.is_military\n    AND COALESCE(f.aircraft_category, '') NOT IN ('Supersonic', 'Business jet', 'Turboprop')\n    AND f.aircraft_icao <> ALL (ARRAY['E135', 'E145', 'E170', 'E175', 'E190', 'E195',\n         'F18H', 'VF35', 'BE90', 'GLF7', 'FAL7', 'FAL8', 'FAL9', 'FAL0',\n         'AT42', 'DH8Q', 'PC21', 'EMB1', 'EMB2', 'EMB3', 'EMB4', 'EMB5'])\n    AND f.aircraft_icao NOT LIKE 'MIG%' AND f.aircraft_icao NOT LIKE 'MIR%'\n    AND f.aircraft_icao NOT LIKE 'F-%' AND f.aircraft_icao NOT LIKE 'SU-%' AND f.aircraft_icao NOT LIKE 'TU-%'\n) ranked\nWHERE rn = 1\nORDER BY max_gs_kt DESC\nLIMIT 20"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "md",
        "footer": {
          "show": false,
          "reducer": [
            "sum"
          ],
