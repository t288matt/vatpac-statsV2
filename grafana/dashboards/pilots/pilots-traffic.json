            "uid": "vatpac"
          },
          "refId": "A",
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT (f.start_time AT TIME ZONE 'UTC')::date AS flight_date,\n       trim(to_char(f.start_time AT TIME ZONE 'UTC', 'Day')) AS day_name,\n       count(*) AS total_flights\nFROM flight_ext f\nWHERE f.start_time BETWEEN $__timeFrom() AND $__timeTo()\nGROUP BY 1, 2\nORDER BY total_flights DESC, flight_date DESC\nLIMIT 5"
        }
      ],
