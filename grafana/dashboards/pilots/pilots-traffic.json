    {
      "id": 2,
      "type": "table",
      "title": "Most popular international routes (last 30 days)",
      "description": "Most popular routes over the last 30 days with at least one end outside the home region.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "vatpac"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 9
