          "refId": "A",
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT (f.logon_time AT TIME ZONE 'UTC')::date AS member_date,\n       trim(to_char(f.logon_time AT TIME ZONE 'UTC', 'Day')) AS day_name,\n       count(DISTINCT f.cid) AS unique_pilots,\n       row_number() OVER (ORDER BY count(DISTINCT f.cid) DESC, (f.logon_time AT TIME ZONE 'UTC')::date DESC) AS rank\nFROM flight f\nWHERE f.logon_time BETWEEN $__timeFrom() AND $__timeTo()\nGROUP BY 1, 2\nORDER BY unique_pilots DESC, member_date DESC\nLIMIT 10"
        }
