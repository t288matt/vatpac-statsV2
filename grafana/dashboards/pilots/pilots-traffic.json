      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "vatpac"
          },
          "refId": "A",
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT route_label AS route, departure, arrival, count(*) AS flights, count(DISTINCT cid) AS pilots\nFROM flight_ext f\nWHERE f.end_time BETWEEN $__timeFrom() AND $__timeTo()\n  AND f.departure <> f.arrival\n  AND NOT f.is_zzzz\n  AND NOT (f.dep_is_home AND f.arr_is_home)\nGROUP BY route_label, departure, arrival\nORDER BY flights DESC, route\nLIMIT 10"
        }
