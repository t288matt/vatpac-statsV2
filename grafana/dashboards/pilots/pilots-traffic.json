    {
      "id": 13,
      "type": "table",
      "title": "Busiest days by flights (last 5 years)",
      "description": "The five days with the most flights over the last 5 years (UTC).",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "vatpac"
      },
      "gridPos": {
