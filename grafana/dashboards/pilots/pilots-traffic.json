    {
      "id": 5,
      "type": "table",
      "title": "Pilots with the most diverse routes (last 14 days)",
      "description": "Pilots who flew the most distinct routes over the last 14 days.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "vatpac"
      },
      "gridPos": {
        "x": 12,
        "y": 14,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "vatpac"
          },
          "refId": "A",
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT (array_agg(f.name ORDER BY f.end_time DESC))[1] AS pilot,\n       count(DISTINCT route_label) AS unique_routes,\n       count(*) AS total_flights\nFROM flight_ext f\nWHERE f.end_time BETWEEN $__timeFrom() AND $__timeTo()\n  AND f.duration_minutes > 60\n  AND NOT f.is_zzzz\nGROUP BY f.cid\nORDER BY unique_routes DESC, total_flights DESC\nLIMIT 10"
        }
      ],
