    {
      "id": 16,
      "type": "table",
      "title": "Which member spent the most time online? (last 7 days)",
      "description": "Australian-based pilots with the most airborne hours over the last 7 days, regardless of the time selector.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "vatpac"
      },
      "gridPos": {
        "x": 0,
        "y": 73,
        "w": 12,
        "h": 10
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "vatpac"
          },
          "refId": "A",
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH flight_summaries AS (\n  -- v3 stand-in for the v1 table: one row per flight\n  SELECT cid, name, logon_time,\n         end_time AS completion_time,\n         airborne_minutes AS total_enroute_time_minutes,\n         duration_minutes AS time_online_minutes\n  FROM flight\n)\nSELECT\n    cid,\n    name,\n    ROUND(enroute_minutes / 60.0) AS total_enroute_hours\nFROM (\n    SELECT\n        cid,\n        COALESCE((ARRAY_AGG(name ORDER BY logon_time DESC NULLS LAST)\n                  FILTER (WHERE name IS NOT NULL AND name <> ''))[1], cid::text) AS name,\n        SUM(total_enroute_time_minutes) AS enroute_minutes\n    FROM flight_summaries\n    WHERE total_enroute_time_minutes > 30\n        AND completion_time >= NOW() - INTERVAL '7 days'\n    GROUP BY cid\n) per_member\nWHERE SUBSTRING(name FROM LENGTH(name) - 3 FOR 1) = 'Y'\nORDER BY enroute_minutes DESC, cid\nLIMIT 10"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "md",
