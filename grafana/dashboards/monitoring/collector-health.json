          "refId": "A",
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroupAlias(polled_at, $__interval),\n       sum(pilots_kept) AS \"Pilot rows\",\n       sum(controllers_kept) AS \"Controller rows\"\nFROM poll_history\nWHERE $__timeFilter(polled_at)\n  AND status = 'ok'\nGROUP BY 1\nORDER BY 1"
        }
