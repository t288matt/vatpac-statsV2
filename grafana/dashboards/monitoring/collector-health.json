    {
      "id": 14,
      "type": "timeseries",
      "title": "Poll duration",
      "description": "Average and maximum poll duration in milliseconds (polls that reached the feed).",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "vatpac"
      },
      "gridPos": {
        "x": 0,
        "y": 23,
        "w": 12,
