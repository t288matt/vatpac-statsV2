    {
      "id": 2,
      "type": "stat",
      "title": "Newest snapshot age",
      "description": "Seconds since the newest stored snapshot (network_snapshot). Replaces v1 card 118 (flights table freshness). Amber from 60 s, red from 300 s (watchdog thresholds).",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "vatpac"
      },
      "gridPos": {
        "x": 0,
        "y": 2,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "vatpac"
          },
          "refId": "A",
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT round(age_seconds::numeric, 0) AS \"Seconds\" FROM monitor_freshness WHERE source = 'network_snapshot'"
        }
      ],
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
