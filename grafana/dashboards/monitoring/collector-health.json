      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "vatpac"
          },
          "refId": "A",
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT round(100.0 * count(*) FILTER (WHERE status = 'skipped_unchanged') / NULLIF(count(*), 0), 1) AS \"Unchanged (%)\"\nFROM poll_history\nWHERE polled_at >= now() - interval '24 hours'"
        }
      ],
      "options": {
