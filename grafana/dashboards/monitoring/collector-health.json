    {
      "id": 6,
      "type": "stat",
      "title": "Snapshots missed (last 24 hours)",
      "description": "Percentage of expected snapshots missing over the last 24 hours. Target: under 1%.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "vatpac"
      },
      "gridPos": {
        "x": 16,
        "y": 3,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "vatpac"
          },
          "refId": "A",
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT GREATEST(0, round(100.0 * (1 - n.actual / NULLIF(n.expected, 0)), 2)) AS \"Missed (%)\"\nFROM (\n  SELECT count(*)::numeric AS actual,\n         floor(extract(epoch FROM (now() - GREATEST(now() - interval '24 hours', (SELECT go_live FROM data_since)))) / (SELECT poll_interval_s FROM poll_cadence)) AS expected\n  FROM network_history\n  WHERE observed_at >= now() - interval '24 hours'\n) n"
        }
      ],
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "auto",
        "showPercentChange": false,
        "percentChangeColorMode": "same_as_value",
        "wideLayout": false,
        "orientation": "auto",
        "text": {
          "valueSize": 40
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#1FAF8A",
                "value": null
              },
              {
                "color": "#E69F00",
                "value": 1
              },
              {
                "color": "#D55E00",
                "value": 5
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Unchanged polls (last 24 hours)",
      "description": "Share of polls in the last 24 hours that found the feed unchanged and were skipped.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "vatpac"
