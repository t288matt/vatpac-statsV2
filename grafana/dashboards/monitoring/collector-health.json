    {
      "id": 9,
      "type": "stat",
      "title": "Rejected values (last 24 hours)",
      "description": "Values the feed sent that the collector dropped or cut (poll_log.rejected_values): groundspeed or altitude outside the plausibility caps (stored as NULL), numbers that cannot be parsed or are out of range, malformed entries that were skipped, and text cut to its length cap. A persistent condition counts on every poll (one over-length name is about 2,880 a day at 30 s polling), so a steady non-zero figure usually means one bad feed entry, not many. Orange at 5,000 in 24 hours.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "vatpac"
      },
      "gridPos": {
        "x": 4,
        "y": 6,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "vatpac"
          },
          "refId": "A",
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT COALESCE(sum(rejected_values), 0) AS \"Rejected\" FROM poll_history\nWHERE polled_at >= now() - interval '24 hours'"
        }
      ],
      "options": {
        "reduceOptions": {
