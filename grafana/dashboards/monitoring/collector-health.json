      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "vatpac"
          },
          "refId": "A",
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT round(age_seconds::numeric, 0) AS \"Seconds\" FROM monitor_freshness WHERE source = 'network_snapshot'"
        }
      ],
      "options": {
