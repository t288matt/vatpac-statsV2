          "refId": "A",
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroupAlias(polled_at, $__interval),\n       avg(duration_ms) AS \"Average (ms)\",\n       max(duration_ms) AS \"Maximum (ms)\"\nFROM poll_history\nWHERE $__timeFilter(polled_at)\n  AND duration_ms IS NOT NULL\nGROUP BY 1\nORDER BY 1"
        }
