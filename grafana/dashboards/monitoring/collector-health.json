    {
      "id": 6,
      "type": "stat",
      "title": "Snapshots missed (last 24 hours)",
      "description": "Percentage of the expected snapshots (one every POLL_INTERVAL_SECONDS since go-live, at most 24 hours; for 24 hours after a change of the interval the figure is off because the window mixes both) that are not in network_snapshot. Acceptance target: under 1%.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "vatpac"
      },
      "gridPos": {
        "x": 16,
        "y": 2,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "vatpac"
          },
          "refId": "A",
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT GREATEST(0, round(100.0 * (1 - n.actual / NULLIF(n.expected, 0)), 2)) AS \"Missed (%)\"\nFROM (\n  SELECT count(*)::numeric AS actual,\n         floor(extract(epoch FROM (now() - GREATEST(now() - interval '24 hours', (SELECT go_live FROM data_since)))) / (SELECT poll_interval_s FROM poll_cadence)) AS expected\n  FROM network_history\n  WHERE observed_at >= now() - interval '24 hours'\n) n"
        }
      ],
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Unchanged polls (last 24 hours)",
      "description": "Share of polls that found the feed unchanged and were skipped (status skipped_unchanged). Expected to be fairly high because the poller retries within a feed interval; informational only.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "vatpac"
      },
      "gridPos": {
        "x": 20,
        "y": 2,
        "w": 4,
        "h": 4
