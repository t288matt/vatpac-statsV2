    {
      "id": 12,
      "type": "timeseries",
      "title": "Polls by outcome",
      "description": "Poll attempts per bucket by status.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "vatpac"
      },
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "vatpac"
          },
          "refId": "A",
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroupAlias(polled_at, $__interval),\n       count(*) FILTER (WHERE status = 'ok') AS \"ok\",\n       count(*) FILTER (WHERE status = 'skipped_unchanged') AS \"skipped_unchanged\",\n       count(*) FILTER (WHERE status = 'error') AS \"error\"\nFROM poll_history\nWHERE $__timeFilter(polled_at)\nGROUP BY 1\nORDER BY 1"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull",
            "max",
            "min",
            "mean"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "#1FAF8A"
          },
          "decimals": 0,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 28,
            "gradientMode": "opacity",
            "showPoints": "never",
            "spanNulls": true,
            "axisPlacement": "left",
            "axisSoftMin": 0,
            "axisBorderShow": false
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "ok"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#1FAF8A"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "skipped_unchanged"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#8A97B2"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "error"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#D55E00"
                }
              }
            ]
          }
        ]
      },
      "interval": "5m"
    },
