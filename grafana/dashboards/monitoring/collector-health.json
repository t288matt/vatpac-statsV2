    {
      "id": 12,
      "type": "timeseries",
      "title": "Polls by outcome",
      "description": "Poll attempts per bucket by status.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "vatpac"
      },
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "vatpac"
          },
          "refId": "A",
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroupAlias(polled_at, $__interval),\n       count(*) FILTER (WHERE status = 'ok') AS \"ok\",\n       count(*) FILTER (WHERE status = 'skipped_unchanged') AS \"skipped_unchanged\",\n       count(*) FILTER (WHERE status = 'error') AS \"error\"\nFROM poll_history\nWHERE $__timeFilter(polled_at)\nGROUP BY 1\nORDER BY 1"
        }
      ],
      "options": {},
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "interval": "5m"
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Rows written (pilot and controller records kept per snapshot)",
      "description": "Pilot position rows and controller sightings written, summed per bucket over polls with status ok.",
