    {
      "id": 2,
      "type": "stat",
      "title": "Newest snapshot age",
      "description": "Seconds since the newest network snapshot was stored. Amber from 60 s, red from 300 s.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "vatpac"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 4,
        "h": 4
