    {
      "id": 3,
      "type": "timeseries",
      "title": "Share of YMML-YSSY airborne time flown by local pilots (Mondays 0700-1200Z)",
      "description": "Weekly share of Melbourne-Sydney airborne time flown by home-region pilots, Mondays 0700 to 1200 UTC.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "vatpac"
      },
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "vatpac"
          },
          "refId": "A",
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT (date_trunc('week', f.end_time AT TIME ZONE 'UTC')) AT TIME ZONE 'UTC' AS time,\n       round(100.0 * COALESCE(sum(f.airborne_minutes) FILTER (WHERE f.pilot_is_local), 0)\n             / NULLIF(sum(f.airborne_minutes), 0), 1) AS \"Local pilots (%)\"\nFROM flight_ext f\nWHERE f.end_time BETWEEN $__timeFrom() AND $__timeTo()\n  AND extract(isodow FROM f.end_time AT TIME ZONE 'UTC') = 1\n  AND (f.end_time AT TIME ZONE 'UTC')::time >= time '07:00'\n  AND (f.end_time AT TIME ZONE 'UTC')::time < time '12:00'\n  AND ((f.departure = 'YMML' AND f.arrival = 'YSSY') OR (f.departure = 'YSSY' AND f.arrival = 'YMML'))\n  AND f.airborne_minutes > 0\nGROUP BY 1\nORDER BY 1"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull",
            "max",
            "min",
            "mean"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "#3AA0DD"
          },
          "decimals": 0,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 28,
            "gradientMode": "opacity",
            "showPoints": "never",
            "spanNulls": true,
            "axisPlacement": "left",
            "axisSoftMin": 0,
            "axisBorderShow": false
          },
          "unit": "percent",
          "min": 0,
          "max": 100
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Local pilots (%)"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#3AA0DD"
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Airborne aircraft during the latest Monday event (0700-1200Z, 5-minute slots)",
      "description": "Aircraft airborne in each 5-minute slot, 0700 to 1200 UTC on the latest Monday event.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "vatpac"
      },
      "gridPos": {
        "x": 0,
        "y": 23,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "vatpac"
          },
          "refId": "A",
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "WITH mon AS (\n  -- The most recent Monday whose 0700Z start has passed: 7 hours back from now, so Monday 00:00 to 06:59Z still shows last Monday\n  SELECT (date_trunc('day', (now() - interval '7 hours') AT TIME ZONE 'UTC')\n          - (extract(isodow FROM (now() - interval '7 hours') AT TIME ZONE 'UTC')::int - 1) * interval '1 day') AT TIME ZONE 'UTC' AS d\n),\nslots AS (\n  SELECT mon.d + interval '7 hours' + n * interval '5 minutes' AS slot\n  FROM mon CROSS JOIN generate_series(0, 59) AS n\n),\nsamples AS (\n  SELECT s.observed_at, s.session_id\n  FROM pilot_sample s\n  WHERE s.observed_at >= (SELECT d FROM mon) + interval '7 hours'\n    AND s.observed_at <  (SELECT d FROM mon) + interval '12 hours'\n    AND s.alt_ft > 1000\n)\nSELECT sl.slot AS time,\n       count(DISTINCT sa.session_id) AS \"Airborne aircraft\"\nFROM slots sl\nLEFT JOIN samples sa\n       ON sa.observed_at >= sl.slot AND sa.observed_at < sl.slot + interval '5 minutes'\nWHERE sl.slot <= now()\nGROUP BY sl.slot\nORDER BY sl.slot"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull",
            "max",
            "min",
            "mean"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "#3AA0DD"
          },
          "decimals": 0,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 28,
            "gradientMode": "opacity",
            "showPoints": "never",
            "spanNulls": true,
            "axisPlacement": "left",
            "axisSoftMin": 0,
            "axisBorderShow": false
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Airborne aircraft"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#3AA0DD"
                }
              }
            ]
          }
        ]
      }
    }
  ]
