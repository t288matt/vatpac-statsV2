    {
      "id": 2,
      "type": "timeseries",
      "title": "Monday event attendance (0700-1200Z)",
      "description": "Pilots and controllers present between 0700 and 1200 UTC on each Monday.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "vatpac"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "vatpac"
          },
          "refId": "A",
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT win_start AS time, pilot_cids AS \"Pilots\", controller_cids AS \"Controllers\"\nFROM monday_attendance\nWHERE win_start BETWEEN $__timeFrom() AND $__timeTo()\nORDER BY win_start"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull",
            "max",
            "min",
            "mean"
          ]
        },
        "tooltip": {
