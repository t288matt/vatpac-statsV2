    {
      "id": 7,
      "type": "barchart",
      "title": "Active pilots and controllers (last 90 days, log scale)",
      "description": "Pilots (30+ minutes airborne) and controllers by rating (30+ minute sessions) over the last 90 days, on a log scale.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "vatpac"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "vatpac"
          },
          "refId": "A",
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT label, people FROM (\n  SELECT -100 AS sort, 'Pilots' AS label, count(DISTINCT f.cid) AS people\n  FROM flight_ext f\n  WHERE f.end_time BETWEEN $__timeFrom() AND $__timeTo()\n    AND f.airborne_minutes >= 30\n  UNION ALL\n  SELECT min(r.rating) AS sort, r.label, count(DISTINCT r.cid) AS people\n  FROM (\n    SELECT c.rating, c.cid,\n           CASE c.rating WHEN 1 THEN 'Obs' WHEN 2 THEN 'S1' WHEN 3 THEN 'S2' WHEN 4 THEN 'S3' WHEN 5 THEN 'C1'\n                         WHEN 6 THEN 'C2' WHEN 7 THEN 'C3' WHEN 8 THEN 'I1' WHEN 9 THEN 'I2' WHEN 10 THEN 'I3'\n                         WHEN 11 THEN 'Supervisor' WHEN 12 THEN 'Administrator' ELSE 'Unknown' END AS label\n    FROM controller_session_ranked c\n    WHERE (c.session_start BETWEEN $__timeFrom() AND $__timeTo() OR c.session_end BETWEEN $__timeFrom() AND $__timeTo())\n      AND c.duration_minutes >= 30\n  ) r\n  GROUP BY r.label\n) x\nORDER BY sort"
        }
      ],
      "options": {
        "xField": "label",
        "showValue": "always",
        "legend": {
          "showLegend": false,
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "scaleDistribution": {
              "type": "log",
              "log": 10
            },
            "fillOpacity": 85,
            "gradientMode": "none",
            "lineWidth": 0
          },
          "color": {
            "mode": "fixed",
            "fixedColor": "#3AA0DD"
          },
          "decimals": 0
        },
        "overrides": []
      },
      "timeFrom": "90d"
    }
