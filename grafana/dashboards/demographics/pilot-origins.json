    {
      "id": 3,
      "type": "piechart",
      "title": "Who flies most in Australian airspace: flights by home region (last 30 days)",
      "description": "Flights per pilot home region over the last 30 days.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "vatpac"
      },
      "gridPos": {
        "x": 8,
        "y": 5,
        "w": 8,
        "h": 10
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "vatpac"
          },
          "refId": "A",
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT pilot_region AS region, count(*) AS flights\nFROM flight_ext f\nWHERE f.end_time BETWEEN $__timeFrom() AND $__timeTo()\nGROUP BY pilot_region\nORDER BY flights DESC"
        }
