    {
      "id": 4,
      "type": "piechart",
      "title": "Who spends most time in Australian airspace: airborne hours by home region (last 30 days)",
      "description": "Airborne hours per pilot home region over the last 30 days.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "vatpac"
      },
      "gridPos": {
        "x": 16,
        "y": 5,
        "w": 8,
        "h": 10
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "vatpac"
          },
          "refId": "A",
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT pilot_region AS region, round((sum(airborne_minutes) / 60.0)::numeric, 1) AS hours\nFROM flight_ext f\nWHERE f.end_time BETWEEN $__timeFrom() AND $__timeTo()\n  AND airborne_minutes > 0\nGROUP BY pilot_region\nORDER BY hours DESC"
        }
      ],
      "options": {
        "reduceOptions": {
          "values": true,
          "calcs": [],
          "fields": "/^hours$/"
