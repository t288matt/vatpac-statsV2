    {
      "id": 5,
      "type": "barchart",
      "title": "Flights by joining cohort (CID range, last 30 days)",
      "description": "Flights and distinct pilots by CID range over the last 30 days, a rough guide to when pilots joined.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "vatpac"
      },
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 16,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "vatpac"
          },
          "refId": "A",
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT (split_part(cohort, '-', 1)::bigint / 10000)::text || '-' AS cohort,\n       count(*) AS flights,\n       count(DISTINCT cid) AS pilots\nFROM cohorts\nWHERE end_time BETWEEN $__timeFrom() AND $__timeTo()\nGROUP BY cid_group, cohort\nORDER BY cid_group"
        }
      ],
      "options": {
        "xField": "cohort",
        "showValue": "always",
        "legend": {
