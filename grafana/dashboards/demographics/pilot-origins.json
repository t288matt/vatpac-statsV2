    {
      "id": 2,
      "type": "piechart",
      "title": "Where pilots currently online come from",
      "description": "Home region of the pilots online now.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "vatpac"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 8,
        "h": 10
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "vatpac"
          },
          "refId": "A",
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT region, count(DISTINCT cid) AS pilots\nFROM pilot_online_now\nGROUP BY region\nORDER BY pilots DESC"
        }
