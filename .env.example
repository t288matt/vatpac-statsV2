# Copy to .env and fill in, or generate one with random passwords:  sh ops/gen_env.sh
# NEVER commit .env.
#
# SECRETS ARE DELIBERATELY BLANK. `docker compose` fails until they are set, and `make up` runs
# ops/check_env.sh, which rejects blank values, change-me* placeholders, values under 16
# characters, repeated values, and anything that is not letters and digits (passwords are placed
# inside connection URLs). `sh ops/gen_env.sh` writes a .env with `openssl rand -hex 24` values.

# --- database (superuser/owner: used by the db and migrate services and by restore only) ---
POSTGRES_DB=vatpac
POSTGRES_USER=vatpac
POSTGRES_PASSWORD=
# least-privilege roles, created by the migrate job from these passwords
# read-only role used by Grafana
GRAFANA_RO_PASSWORD=
# role used by the collector (DML on data tables only)
COLLECTOR_DB_PASSWORD=
# read-only role used by pg_dump in the backup service (pg_read_all_data)
BACKUP_DB_PASSWORD=
# read-only role for the watchdog
WATCHDOG_DB_PASSWORD=
# role used by the ATC stats loader (DML on its two tables only)
STATS_LOADER_DB_PASSWORD=

# --- grafana ---
GRAFANA_ADMIN_USER=admin
# Applies ONLY on the first start (when grafana_data is empty). To rotate later:
#   docker compose exec grafana grafana cli admin reset-admin-password '<new>'
GRAFANA_ADMIN_PASSWORD=
GRAFANA_PORT=3300
# Interface Grafana is published on. 127.0.0.1 = this machine only (default, safe).
# For LAN access set the VM's LAN IP, or 0.0.0.0 for all interfaces (then firewall it).
GRAFANA_BIND=127.0.0.1
# set when exposed through a proxy/tunnel, e.g. https://stats.example.com/
GRAFANA_ROOT_URL=http://localhost:3300/
# true ONLY when users reach Grafana over https (reverse proxy/tunnel with TLS); with plain
# http on a LAN a secure cookie would stop logins working
GRAFANA_COOKIE_SECURE=false

# --- collector (defaults match collector/src/vatpac/settings.py; ops/check_config_drift.py enforces this) ---
VATSIM_FEED_URL=https://data.vatsim.net/v3/vatsim-data.json
VATSIM_STATUS_URL=https://status.vatsim.net/status.json
POLL_INTERVAL_SECONDS=30
HTTP_TIMEOUT_SECONDS=10
# free-text fields (name, route, remarks and so on) are cut to this many characters at ingest (100 to 100000)
TEXT_MAX_LENGTH=2000
# a feed snapshot dated more than this many seconds ahead of the clock is rejected as a feed error (15 to 3600)
FEED_MAX_FUTURE_SECONDS=120
# longest gap between two position samples counted as flying time (blank: 2.5 x POLL_INTERVAL_SECONDS)
AIRBORNE_GAP_CAP_SECONDS=
HOME_ICAO_PREFIXES=Y
LOG_LEVEL=INFO
# Port of the collector /health endpoint inside the container
HEALTH_PORT=8080
# consecutive upstream failures that open the circuit breaker (polling never stops)
CIRCUIT_FAILURE_THRESHOLD=5
# poll cadence in seconds while the breaker is open
CIRCUIT_SLOW_INTERVAL_SECONDS=60
# --- rolling raw-feed archive (collector; docs/RUNBOOKS/feed-archive.md) ---
ARCHIVE_ENABLED=true
# directory inside the container (a named volume)
ARCHIVE_DIR=/archive
# a compact record (all pilots and controllers, audit fields) every N seconds (how long they are kept is set in docker-compose.yml)
ARCHIVE_COMPACT_EVERY_S=300
# the full raw payload every N seconds
ARCHIVE_FULL_EVERY_S=3600
# a feed timestamp gap above this many seconds is an anomaly (blank: 2 x POLL_INTERVAL_SECONDS + 5)
ARCHIVE_GAP_S=
# Tag/label baked into the collector image (the release workflow sets this from the git tag)
VATPAC_VERSION=dev

# --- ATC stats loader (issue 387; defaults are written in docker-compose.yml, and ops/check_config_drift.py checks them) ---
# STATS_RUN_AT, STATS_MIN_INTERVAL_SECONDS and STATS_PAGE_SIZE are plain values in docker-compose.yml, not read from here.
# days before the newest stored date that every run loads again
STATS_OVERLAP_DAYS=2
# How long sessions are kept (STATS_RETENTION_YEARS) is a policy value set in docker-compose.yml, not here.

# --- registry images (issue 173; OFF by default, leave the line commented for local builds) ---
# Unset, the five built services (migrate, collector, backup, watchdog and the ATC stats loader, image vatpac-stats-loader) use vatpac-stats-<name>:latest, built by `make up` or
# `docker compose up -d --build`. Set the prefix to run the images published by the release workflow instead (production only;
# the owner is told the exact line first). The prefix ends with a slash. Set it once: the tag defaults to `latest`, which the
# release workflow moves to each published commit, so a deploy never edits .env. VATPAC_IMAGE_TAG is an optional override used
# only to pin an older build (sha- plus the first 7 characters of a commit); leave it out. Nothing secret here.
# Deploy in this mode with `make deploy`.
#VATPAC_IMAGE_PREFIX=ghcr.io/t288matt/
#VATPAC_IMAGE_TAG=

# --- watchdog / alerts (optional) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
UPTIME_KUMA_PUSH_URL=
# 1 (default) = the alert for pilots who log on with a plan and never get airborne only writes what it would send to the watchdog log;
# 0 = send the Telegram messages (issue 331). Restart the watchdog after changing it.
WATCHDOG_NEVER_FLEW_DRY_RUN=1

# --- backup ---
# Nightly backup time, UTC, HH:MM
BACKUP_TIME_UTC=02:00
# seconds pg_dump may run before it is killed and the backup counts as failed (raise it when the database has grown); and the
# limit for the pg_restore -l check of the finished dump
BACKUP_DUMP_TIMEOUT_S=1800
BACKUP_VALIDATE_TIMEOUT_S=300
# a new dump is rejected (moved aside as *.rejected) when smaller than this percent of the previous good dump, or smaller than
# BACKUP_MIN_FIRST_BYTES when there is none; rotation never leaves fewer good dumps than the minimum set in docker-compose.yml
BACKUP_MIN_SIZE_PERCENT=50
BACKUP_MIN_FIRST_BYTES=1048576
# ISO weekday (1=Mon .. 7=Sun) on which the backup is restore-tested; 0 disables
BACKUP_RESTORE_TEST_DAY=7
# Optional off-box copy: a shell command run after every successful backup, with $BACKUP_FILE set
# to the new dump. Empty = off. The command needs a tool in the image: set BACKUP_EXTRA_APT_PACKAGES
# (e.g. "rclone" or "rsync openssh-client") and rebuild. See docs/RUNBOOKS/restore.md "Off-box copies".
BACKUP_REMOTE=
BACKUP_EXTRA_APT_PACKAGES=

# --- watchdog ---
# Thresholds and intervals are policy, not machine settings: they are literals in docker-compose.yml (see docs/CONFIG_MAP.md, section 'Where each setting lives').
