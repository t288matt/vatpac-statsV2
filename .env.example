# Copy to .env and fill in, or generate one with random passwords:  sh ops/gen_env.sh
# NEVER commit .env.
#
# SECRETS ARE DELIBERATELY BLANK. `docker compose` fails until they are set, and `make up` runs
# ops/check_env.sh, which rejects blank values, change-me* placeholders, values under 16
# characters, repeated values, and anything that is not letters and digits (passwords are placed
# inside connection URLs). `sh ops/gen_env.sh` writes a .env with `openssl rand -hex 24` values.

# --- database (superuser/owner: used by the db and migrate services and by restore only) ---
POSTGRES_DB=vatpac
POSTGRES_USER=vatpac
POSTGRES_PASSWORD=
# least-privilege roles, created by the migrate job from these passwords
# read-only role used by Grafana
GRAFANA_RO_PASSWORD=
# role used by the collector (DML on data tables only)
COLLECTOR_DB_PASSWORD=
# read-only role used by pg_dump in the backup service (pg_read_all_data)
BACKUP_DB_PASSWORD=
# read-only role for the watchdog
WATCHDOG_DB_PASSWORD=

# --- grafana ---
GRAFANA_ADMIN_USER=admin
# Applies ONLY on the first start (when grafana_data is empty). To rotate later:
#   docker compose exec grafana grafana cli admin reset-admin-password '<new>'
GRAFANA_ADMIN_PASSWORD=
GRAFANA_PORT=3300
# Interface Grafana is published on. 127.0.0.1 = this machine only (default, safe).
# For LAN access set the VM's LAN IP, or 0.0.0.0 for all interfaces (then firewall it).
GRAFANA_BIND=127.0.0.1
# set when exposed through a proxy/tunnel, e.g. https://stats.example.com/
GRAFANA_ROOT_URL=http://localhost:3300/
# true ONLY when users reach Grafana over https (reverse proxy/tunnel with TLS); with plain
# http on a LAN a secure cookie would stop logins working
GRAFANA_COOKIE_SECURE=false

# --- collector (defaults match collector/src/vatpac/settings.py; ops/check_config_drift.py enforces this) ---
VATSIM_FEED_URL=https://data.vatsim.net/v3/vatsim-data.json
VATSIM_STATUS_URL=https://status.vatsim.net/status.json
POLL_INTERVAL_SECONDS=15
HTTP_TIMEOUT_SECONDS=10
POSITION_RETENTION_DAYS=90
AIRBORNE_GAP_CAP_SECONDS=40
HOME_ICAO_PREFIXES=Y
LOG_LEVEL=INFO
# Port of the collector /health and /metrics endpoint inside the container
HEALTH_PORT=8080
# consecutive upstream failures that open the circuit breaker (polling never stops)
CIRCUIT_FAILURE_THRESHOLD=5
# poll cadence in seconds while the breaker is open
CIRCUIT_SLOW_INTERVAL_SECONDS=60
# free-text fields (name, route, remarks and so on) are cut to this many characters at ingest (100 to 100000)
TEXT_MAX_LENGTH=2000
# Tag/label baked into the collector image (the release workflow sets this from the git tag)
VATPAC_VERSION=dev

# --- watchdog / alerts (optional) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
UPTIME_KUMA_PUSH_URL=

# --- backup ---
BACKUP_RETENTION_DAYS=14
# Nightly backup time, UTC, HH:MM
BACKUP_TIME_UTC=02:00
# ISO weekday (1=Mon .. 7=Sun) on which the backup is restore-tested; 0 disables
BACKUP_RESTORE_TEST_DAY=7
# Optional off-box copy: a shell command run after every successful backup, with $BACKUP_FILE set
# to the new dump. Empty = off. The command needs a tool in the image: set BACKUP_EXTRA_APT_PACKAGES
# (e.g. "rclone" or "rsync openssh-client") and rebuild. See docs/RUNBOOKS/restore.md "Off-box copies".
BACKUP_REMOTE=
BACKUP_EXTRA_APT_PACKAGES=

# --- watchdog knobs ---
WATCHDOG_INTERVAL_SECONDS=60
# newest ok poll_log / network_snapshot age: warn and page thresholds (seconds)
WATCHDOG_WARN_SECONDS=60
WATCHDOG_PAGE_SECONDS=300
# a state change must persist this many cycles before it is alerted (debounce)
WATCHDOG_CONFIRM_CYCLES=2
# disk usage percent that alerts (critical at +10)
WATCHDOG_DISK_PCT=80
# comma separated paths whose filesystem is checked (inside the watchdog container)
WATCHDOG_DISK_PATHS=/backups,/
# database size in GB that raises a warning
WATCHDOG_DB_MAX_GB=20
WATCHDOG_BACKUP_MAX_HOURS=26
# warn if the last successful restore test is older than this many days (0 disables the age check)
WATCHDOG_RESTORE_TEST_MAX_DAYS=9
